    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Cortex Debug (S+NS)",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/Secure/build/tz_pg_S.elf",
            "loadFiles": [
                "${workspaceFolder}/Secure/build/tz_pg_S.elf",
                "${workspaceFolder}/NonSecure/build/tz_pg_NS.elf"
            ],
            "postLaunchCommands": [
                "add-symbol-file NonSecure/build/tz_pg_NS.elf"
            ],
            "request": "launch",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "servertype": "openocd",
            "showDevDebugOutput": "raw",
            "configFiles": ["board/st_nucleo_h5.cfg"]
        }
    ]
}

